# Домен приложения (без слэша на конце)
APP_DOMAIN=funny-frog.jumpingcrab.com
PUBLIC_URL=https://funny-frog.jumpingcrab.com

# Email для Let's Encrypt уведомлений
ACME_EMAIL=you@example.com

# Postgres
POSTGRES_USER=frog
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=frogdb

# MinIO (root credentials)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=frog-photos

# Backend
APP_ENV=production
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=https://funny-frog.jumpingcrab.com
ROOT_PATH=/api
MINIO_PUBLIC_URL=https://funny-frog.jumpingcrab.com/s3

# Traefik dashboard basic auth (htpasswd, экранируй $ как $$)
# Пример пустой — dashboard выключен
TRAEFIK_DASHBOARD_AUTH=

# MinIO console basic auth
MINIO_CONSOLE_AUTH=
